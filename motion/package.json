{
  "name": "aqvl-motion",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "brand": "node scripts/brand.mjs write",
    "textures": "node scripts/textures.mjs && remotion still src/index.ts WallFrame public/tex/wall.png --frame=0",
    "draft": "remotion render src/index.ts Film out/attempts/draft.mp4 --scale=0.5 --crf=20",
    "master": "remotion render src/index.ts Film out/tmp/master.mp4 --image-format=png --codec=h264 --crf=10 --pixel-format=yuv420p",
    "final": "ffmpeg -y -i out/tmp/master.mp4 -an -c:v libx264 -preset slow -crf 16 -pix_fmt yuv420p -profile:v high -r 30 -movflags +faststart -color_primaries bt709 -color_trc bt709 -colorspace bt709 out/aqvl-launch-film.mp4"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "^4.0.532",
    "@remotion/fonts": "^4.0.532",
    "@remotion/google-fonts": "^4.0.532",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "typescript": "^7.0.2"
  }
}
