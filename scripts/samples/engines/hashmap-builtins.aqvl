SCENE HashMapBuiltins
DECLARE
  HASH_MAP h = {a:1, b:2, i:3, q:4}

SEQUENCE
  HASHMAP_LOOKUP h a
  HASHMAP_LOOKUP h q
  HASHMAP_LOOKUP h missing
  HASHMAP_INSERT h a 10
  HASHMAP_INSERT h y 5
  HASHMAP_INSERT h z 6
  HASHMAP_INSERT h r 7
  HASHMAP_LOOKUP h z
  HASHMAP_DELETE h b
  HASHMAP_DELETE h a
  HASHMAP_DELETE h nothing
  HASHMAP_LOOKUP h i
END
