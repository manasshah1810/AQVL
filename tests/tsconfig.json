{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["vitest/globals"]
  },
  "include": ["integration/**/*.ts", "unit/**/*.ts", "utils/**/*.ts"]
}
