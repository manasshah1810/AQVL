{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(pnpm --filter @aqvl/tests test -- defaultLayoutParams)",
      "Bash(npm run *)",
      "Bash(pnpm -r build)",
      "Bash(pnpm --filter @aqvl/tests test -- spatial-layout-performance)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}