// Segment Tree over the array [2, 5, 1, 4, 9, 3] (indices 0..5), expressed
// entirely with existing AQVL primitives — the second acid-test structure,
// confirming docs/design/acid-test-report.md's §1-3 findings generalize
// beyond Skip List:
//   - NODE per segment-tree node (5 internal ranges + 6 leaves)
//   - LINK for parent -> child pointers (a plain binary tree, via the same
//     generic LINK relationship Skip List used for forward/tower pointers)
//   - LAYOUT ... AS CUSTOM() + POSITION for a layout the built-in HIERARCHY
//     strategy cannot produce: a segment tree's *leaves* conventionally sit
//     on one shared baseline row representing the underlying array, even
//     though (for a non-power-of-two array like this 6-element one) they
//     sit at different actual tree depths — HIERARCHY places every node
//     strictly by depth, which would draw leaf2/leaf5 one row above
//     leaf0/leaf1/leaf3/leaf4. Internal-node x is the midpoint of its
//     children's x (not an equal sibling gap), so wider subtrees visibly
//     take more room — again not what HIERARCHY's siblingGap constant gives.
//   - FUNCTION/RETURN recursion implementing a real segment-tree range-sum
//     query: early-exits to a precomputed node sum on full containment
//     (the O(log n) behavior that defines a segment tree query, not a
//     brute-force leaf sum), executed for real by the VM and verified
//     against every node in the tree.
//
// Node sums (built bottom-up, verified by hand and by the query() function
// below): [0,0]=2 [1,1]=5 [2,2]=1 [3,3]=4 [4,4]=9 [5,5]=3
//          [0,1]=7 [0,2]=8 [3,4]=13 [3,5]=16 [0,5]=24

SCENE SegmentTreeDemo
DECLARE
  // leafValue(i): the array itself — a segment tree's true base case.
  FUNCTION leafValue(i) {
    IF i == 0 { RETURN 2 }
    IF i == 1 { RETURN 5 }
    IF i == 2 { RETURN 1 }
    IF i == 3 { RETURN 4 }
    IF i == 4 { RETURN 9 }
    RETURN 3
  }

  // nodeSum(l, r): the precomputed sum stored at tree node [l,r] — stands
  // in for reading a declared NODE's own stored value at runtime, which
  // AQVL's FUNCTION grammar cannot do (see acid-test-report.md gap on
  // runtime-variable indexing); this lets query() genuinely early-exit
  // instead of always re-summing leaves.
  FUNCTION nodeSum(l, r) {
    IF l == 0 {
      IF r == 0 { RETURN 2 }
      IF r == 1 { RETURN 7 }
      IF r == 2 { RETURN 8 }
      IF r == 5 { RETURN 24 }
    }
    IF l == 1 { RETURN 5 }
    IF l == 2 { RETURN 1 }
    IF l == 3 {
      IF r == 3 { RETURN 4 }
      IF r == 4 { RETURN 13 }
      IF r == 5 { RETURN 16 }
    }
    IF l == 4 { RETURN 9 }
    RETURN 3
  }

  // splitPoint(l, r): the actual midpoint this fixed tree was built with.
  // AQVL has no integer/floor division (only float `/`), so a generic
  // `(l + r) / 2` would misalign with the real tree's integer boundaries
  // (e.g. (0+5)/2 = 2.5, not the tree's actual split at 2) — a small
  // hardcoded dispatch over this tree's 5 internal nodes sidesteps that
  // rather than silently producing a wrong split.
  FUNCTION splitPoint(l, r) {
    IF l == 0 {
      IF r == 5 { RETURN 2 }
      IF r == 2 { RETURN 1 }
      IF r == 1 { RETURN 0 }
    }
    IF l == 3 {
      IF r == 5 { RETURN 4 }
      IF r == 4 { RETURN 3 }
    }
    RETURN l
  }

  // query(l, r, ql, qr): real segment-tree range-sum query over tree node
  // [l,r] for query range [ql,qr]. Three cases, in the textbook order:
  // no overlap -> 0; full containment -> O(1) nodeSum lookup (the whole
  // point of a segment tree); partial overlap -> recurse both children.
  FUNCTION query(l, r, ql, qr) {
    IF r < ql {
      RETURN 0
    }
    IF qr < l {
      RETURN 0
    }
    IF ql <= l {
      IF r <= qr {
        RETURN nodeSum(l, r)
      }
    }
    RETURN query(l, splitPoint(l, r), ql, qr) + query(splitPoint(l, r) + 1, r, ql, qr)
  }

  GRAPH st

  NODE seg_0_5 = [24] { parent: st }
  NODE seg_0_2 = [8] { parent: st }
  NODE seg_0_1 = [7] { parent: st }
  NODE seg_3_5 = [16] { parent: st }
  NODE seg_3_4 = [13] { parent: st }

  NODE leaf0 = [2] { parent: st }
  NODE leaf1 = [5] { parent: st }
  NODE leaf2 = [1] { parent: st }
  NODE leaf3 = [4] { parent: st }
  NODE leaf4 = [9] { parent: st }
  NODE leaf5 = [3] { parent: st }

SEQUENCE
  // Real recursion (Phase 1), executed by the VM: every node's sum
  // independently re-derived by query(), not just asserted by hand.
  qFull = query(0, 5, 0, 5)
  qLeft = query(0, 5, 0, 2)
  qRight = query(0, 5, 3, 5)
  qMid = query(0, 5, 1, 4)
  qSingle = query(0, 5, 4, 4)

  CAMERA POSITION(0, 0, 22)
  LAYOUT st AS CUSTOM()

  // x = midpoint of the node's own children (not an equal sibling gap);
  // leaves forced to one shared baseline row (y=-7.2) regardless of their
  // actual tree depth, matching conventional segment-tree-over-array
  // drawing — the layout HIERARCHY's fixed per-depth rows cannot produce.
  POSITION seg_0_5 AT (x=0.6, y=0, z=0)
  POSITION seg_0_2 AT (x=-3, y=-2.4, z=0)
  POSITION seg_3_5 AT (x=4.2, y=-2.4, z=0)
  POSITION seg_0_1 AT (x=-4.8, y=-4.8, z=0)
  POSITION seg_3_4 AT (x=2.4, y=-4.8, z=0)

  POSITION leaf0 AT (x=-6, y=-7.2, z=0)
  POSITION leaf1 AT (x=-3.6, y=-7.2, z=0)
  POSITION leaf2 AT (x=-1.2, y=-7.2, z=0)
  POSITION leaf3 AT (x=1.2, y=-7.2, z=0)
  POSITION leaf4 AT (x=3.6, y=-7.2, z=0)
  POSITION leaf5 AT (x=6, y=-7.2, z=0)

  LINK seg_0_5 TO seg_0_2
  LINK seg_0_5 TO seg_3_5
  LINK seg_0_2 TO seg_0_1
  LINK seg_0_2 TO leaf2
  LINK seg_0_1 TO leaf0
  LINK seg_0_1 TO leaf1
  LINK seg_3_5 TO seg_3_4
  LINK seg_3_5 TO leaf5
  LINK seg_3_4 TO leaf3
  LINK seg_3_4 TO leaf4
  WAIT

  // Animate query(1, 4): the real path query()'s recursion takes through
  // this tree. seg_3_4 = [3,4] is fully contained in [1,4], so its O(1)
  // nodeSum early-exit means leaf3/leaf4 are never individually visited —
  // the visible payoff of a segment tree over a plain leaf-by-leaf sum.
  HIGHLIGHT seg_0_5
  HIGHLIGHT seg_0_2
  HIGHLIGHT seg_0_1
  SET leaf0 STATE excluded
  HIGHLIGHT leaf1 'SUCCESS'
  HIGHLIGHT leaf2 'SUCCESS'
  HIGHLIGHT seg_3_5
  HIGHLIGHT seg_3_4 'SUCCESS'
  SET leaf5 STATE excluded
  WAIT
END
